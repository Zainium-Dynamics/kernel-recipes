maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=linux-kernel
pkgver=7.3.4
pkgrel=1
# the one place the kernel's name is set: the image is kernel/$_kernel and the release
# $_kernel-<major>.<minor>, so the module dir and boot paths stay the same across point releases
_kernel=linux-zainium
_krel="$_kernel-${pkgver%.*}"
# NVIDIA's open kernel modules (RTX 20 series and newer), built here so they are signed with
# this kernel's key; their GSP firmware comes from the driver of the same version. Flatpak
# apps get the matching userspace from Flathub's GL.nvidia extension.
_nvver=620.70.06
# the version before it, built instead when $_nvver does not build on this kernel yet
_nvprev=620.70.06
# the kernel goes to the kernel tier (ESP, `zex kernel`); its modules to the base
subpackages="linux-kernel-modules linux-headers"
# GNU sed: AppArmor's capability names are generated with sed's \L, which BusyBox sed
# writes as a literal "L" ("LCHOWN"), so the parser could not match any capability
makedepends="bash clang-dev flex bison bc perl python3 gawk sed rsync findutils diffutils coreutils tar xz zstd cpio kmod elfutils-dev openssl openssl-dev pahole linux-headers qemu-system-x86_64"
source="https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-$pkgver.tar.xz
0001-zainium-system-paths.patch
0002-zainium-module-dir.patch
0003-ovl-sealed-mount.patch
surface-0002-surface3.patch
surface-0003-mwifiex.patch
surface-0004-ath10k.patch
surface-0005-ipts.patch
surface-0006-ithc.patch
surface-0007-surface-sam.patch
surface-0008-surface-sam-over-hid.patch
surface-0009-surface-button.patch
surface-0010-surface-typecover.patch
surface-0011-surface-shutdown.patch
surface-0012-surface-gpe.patch
surface-0013-cameras.patch
surface-0014-amd-gpio.patch
surface-0015-hid-surface.patch
zainium.config
surface.config
zainium-ipe.pol
nvidia.conf
https://github.com/NVIDIA/open-gpu-kernel-modules/archive/refs/tags/$_nvver.tar.gz
https://download.nvidia.com/XFree86/Linux-x86_64/$_nvver/NVIDIA-Linux-x86_64-$_nvver.run
https://github.com/NVIDIA/open-gpu-kernel-modules/archive/refs/tags/$_nvprev.tar.gz
https://download.nvidia.com/XFree86/Linux-x86_64/$_nvprev/NVIDIA-Linux-x86_64-$_nvprev.run"

# Vanilla Linux with Zainium's system paths (firmware, shebangs, init, modprobe, poweroff)
# and the modules under /overlayer/syshub; the release name is given to make (kmake).
# zainium.config is Zainium's own kernel config; build() only adds the desktop-speed
# options to it. Built with GCC like that config: with Rust and BTF both on, the kernel
# does not allow LTO.
# KERNELRELEASE on make's command line is the release as it is (no setlocalversion, no "+")
kmake() {
	make KERNELRELEASE="$_krel" "$@"
}

build() {
	cd "$SRCDIR/linux-$pkgver"
	# the musl loader flags ci/build.sh exports are for userland, not the kernel; with the Rust
	# one bindgen would run on Zainium's loader and could not find libstdc++ for Alpine's libclang;
	# it also has to be linked dynamically, a static musl bindgen cannot dlopen libclang
	unset CFLAGS CPPFLAGS LDFLAGS CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS

	# Rust in the kernel: stable rustc with rust-src, and bindgen (rustup comes from the CI job)
	rustup toolchain install stable --profile minimal --component rust-src
	export RUSTUP_TOOLCHAIN=stable
	RUSTFLAGS="-C target-feature=-crt-static" cargo install --locked --root "$SRCDIR/bindgen" bindgen-cli
	export PATH="$SRCDIR/bindgen/bin:$PATH"

	for p in 0001-zainium-system-paths.patch 0002-zainium-module-dir.patch 0003-ovl-sealed-mount.patch; do
		patch -p1 < "$SRCDIR/$p"
	done
	# Microsoft Surface support from linux-surface (patches/7.3 and configs/surface-7.3.config,
	# github.com/linux-surface/linux-surface), without 0001-secureboot: it reverts the PE
	# header's NX flag and adds a lockdown bypass for hibernation
	for p in "$SRCDIR"/surface-0*.patch; do
		patch -p1 < "$p"
	done

	cp "$SRCDIR/zainium.config" .config
	cat "$SRCDIR/surface.config" >> .config
	# IPE's boot policy is compiled in: no signing key, and it goes wherever this kernel goes
	cp "$SRCDIR/zainium-ipe.pol" zainium-ipe.pol
	# desktop speed on top of Zainium's config: transparent hugepages, zstd for zram, no
	# scheduler stats (-O3 is a compiler flag below: vanilla has no option for it)
	scripts/config -e GENERIC_CPU -e CC_OPTIMIZE_FOR_PERFORMANCE \
		-e TRANSPARENT_HUGEPAGE -e TRANSPARENT_HUGEPAGE_ALWAYS \
		-d ZRAM_DEF_COMP_LZORLE -e ZRAM_DEF_COMP_ZSTD \
		-d SCHEDSTATS -d LATENCYTOP \
		-d DEBUG_INFO_COMPRESSED_NONE -e DEBUG_INFO_COMPRESSED_ZSTD \
		-d X86_DECODER_SELFTEST \
		--set-str IPE_BOOT_POLICY zainium-ipe.pol
	# X86_DECODER_SELFTEST builds arch/x86/tools/insn_sanity with the host compiler, which
	# cannot take the kernel's uapi headers on the musl build host; it is a build-time test only
	kmake olddefconfig
	kmake rustavailable
	# olddefconfig silently drops what the toolchain cannot do (Rust without rustc/bindgen)
	# DM_CRYPT built in: quantra-ramfs opens an encrypted root before any module can load
	for opt in CONFIG_RUST=y CONFIG_DEBUG_INFO_BTF=y \
		CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y CONFIG_TRANSPARENT_HUGEPAGE=y \
		CONFIG_DM_CRYPT=y CONFIG_CRYPTO_XTS=y CONFIG_CRYPTO_AES=y; do
		grep -qx "$opt" .config || { echo "olddefconfig dropped $opt" >&2; return 1; }
	done
	# the live image is zstd EROFS mounted from the initramfs: every built-in EROFS
	# option of Zainium's config must stay built in (ONDEMAND no longer exists in 7.1.8)
	for opt in $(grep '^CONFIG_EROFS_FS[A-Z_]*=y$' "$SRCDIR/zainium.config" | grep -v '^CONFIG_EROFS_FS_ONDEMAND='); do
		grep -qx "$opt" .config || { echo "olddefconfig dropped $opt" >&2; return 1; }
	done
	[ "$(kmake -s kernelrelease)" = "$_krel" ] || { echo "kernelrelease is not $_krel" >&2; return 1; }

	# generic x86-64, so it runs on any 64-bit CPU like the rest of the base, and -O3
	kmake -j"$(nproc)" KCFLAGS="-O3" bzImage modules
	_boot_test
	_nvidia_build
}

# NVIDIA's open modules against this tree: $_nvver, or $_nvprev when the new one does not
# build on this kernel yet. If neither builds the kernel ships without them, and the log says so.
_nvidia_build() {
	for v in "$_nvver" "$_nvprev"; do
		if (cd "$SRCDIR/open-gpu-kernel-modules-$v" && make -j"$(nproc)" modules \
			SYSSRC="$SRCDIR/linux-$pkgver" SYSOUT="$SRCDIR/linux-$pkgver" KERNELRELEASE="$_krel"); then
			echo "$v" > "$SRCDIR/nvidia-built"
			[ "$v" = "$_nvver" ] || echo "WARNING: NVIDIA $_nvver does not build on $pkgver, shipping $v" >&2
			return 0
		fi
		echo "WARNING: NVIDIA open modules $v do not build on $pkgver" >&2
	done
	echo "WARNING: no NVIDIA open modules build on $pkgver, shipping without them" >&2
}

# NVIDIA's modules go to extra/, signed like the rest by modules_install (MODULE_SIG_ALL),
# with the GSP firmware of the same driver version. nvidia.conf keeps them from loading on
# their own: nouveau stays the driver until the user turns NVIDIA's on.
_nvidia_install() {
	v=$(cat "$SRCDIR/nvidia-built")
	kmake M="$SRCDIR/open-gpu-kernel-modules-$v/kernel-open" INSTALL_MOD_PATH="$PAYLOAD_DIR" \
		INSTALL_MOD_DIR=extra INSTALL_MOD_STRIP=1 DEPMOD=true modules_install
	ls "$mods"/extra/nvidia*.ko* >/dev/null || { echo "no NVIDIA modules installed" >&2; return 1; }
	# lockdown loads only signed modules: an unsigned one here would never load
	for m in "$mods"/extra/nvidia*.ko*; do
		[ -n "$(modinfo -F signer "$m")" ] || { echo "$(basename "$m") is not signed" >&2; return 1; }
	done
	echo "NVIDIA $v modules signed: $(cd "$mods/extra" && ls nvidia*.ko* | tr '\n' ' ')"

	run="$SRCDIR/NVIDIA-Linux-x86_64-$v.run"
	rm -rf "$SRCDIR/nvidia-run"
	sh "$run" --extract-only --target "$SRCDIR/nvidia-run" >/dev/null
	fw="$PAYLOAD_DIR/overlayer/syshub/drivers/hardware/firmwares/nvidia/$v"
	mkdir -p "$fw"
	for f in "$SRCDIR"/nvidia-run/firmware/gsp_*.bin; do
		zstd -q -19 "$f" -o "$fw/$(basename "$f").zst"
	done
	ls "$fw"/gsp_*.bin.zst >/dev/null || { echo "no GSP firmware in the NVIDIA driver" >&2; return 1; }

	install -Dm644 "$SRCDIR/nvidia.conf" "$PAYLOAD_DIR/overlayer/syshub/lib/modprobe.d/nvidia.conf"
}

# the kernel's userspace API headers, from the same tree, for the userland
# (/overlayer/zexlib/union/include)
linux_headers() {
	cd "$SRCDIR/linux-$pkgver"
	kmake INSTALL_HDR_PATH="$PAYLOAD_DIR" headers_install
	find "$PAYLOAD_DIR" \( -name .install -o -name ..install.cmd \) -exec rm -f {} +
	# substrate allows no /usr in a package; in the headers it is only comments
	grep -rlI '/usr/' "$PAYLOAD_DIR" | xargs -r sed -i 's#/usr/#/overlayer/syshub/#g'
}
