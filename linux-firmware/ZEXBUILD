maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=linux-firmware
pkgver=20261019
pkgrel=0
source="https://cdn.kernel.org/pub/linux/kernel/firmware/linux-firmware-$pkgver.tar.xz"
makedepends="zstd parallel rdfind coreutils findutils"

package() {
	# the kernel looks for firmware in /overlayer/syshub/drivers/hardware/firmwares
	# (0001-zainium-system-paths.patch) and reads .zst files (FW_LOADER_COMPRESS_ZSTD)
	local fw="$PAYLOAD_DIR/overlayer/syshub/drivers/hardware/firmwares"
	./copy-firmware.sh -j"$(nproc)" --zstd "$fw"
	# no phone/SoC firmware (Qualcomm Snapdragon, Nvidia Tegra) and no
	# server network cards: this is an x86-64 desktop and laptop system
	rm -rf "$fw"/qcom "$fw"/nvidia/tegra* "$fw"/nvidia/gk20a "$fw"/nvidia/gm20b "$fw"/nvidia/gp10b \
		"$fw"/mellanox "$fw"/mrvl/prestera "$fw"/mrvl/cpt0* \
		"$fw"/qed "$fw"/liquidio "$fw"/netronome "$fw"/bnx2x "$fw"/cxgb4
	# links that pointed into what was removed
	find "$fw" -xtype l -delete
	# identical files become relative links
	./dedup-firmware.sh "$fw"
}
